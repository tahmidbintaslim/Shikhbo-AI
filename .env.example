# Copy to .env.local and fill in what you use. See the README for details.
# Never commit .env.local.

# Chat providers, tried in this order. Set at least one.
OPENROUTER_API_KEY=
HF_API_KEY=
GROQ_API_KEY=

# Optional model overrides (defaults live in src/lib/models.ts)
# OPENROUTER_MODEL=
# HF_CHAT_MODEL=
# GROQ_MODEL=
# HF_EMBEDDING_MODEL=

# Textbook retrieval (Upstash Vector). Also needs HF_API_KEY for embeddings.
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Shared rate limit (Upstash Redis). Either pair works; KV_REST_API_* is
# what the Vercel marketplace integration sets and also enables the
# 5-minute answer cache.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional site settings
# NEXT_PUBLIC_APP_URL=https://your-domain.example
# GOOGLE_SITE_VERIFICATION=
