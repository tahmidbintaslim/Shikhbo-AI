# Copy to .env.local and fill in what you use. See the README for details.
# Never commit .env.local. With none of the chat keys set, the app runs and
# /api/teach answers 503 "not_configured".

# Chat providers, tried in this order. Set at least one.
OPENROUTER_API_KEY=
HF_API_KEY=
GROQ_API_KEY=

# Optional model overrides (defaults live in src/lib/models.ts)
# OPENROUTER_MODEL=
# HF_CHAT_MODEL=
# GROQ_MODEL=

# Storage: the shikhbo-api Supabase Edge Function (supabase/functions/shikhbo-api)
# holds the textbook index, the 5-minute answer cache and the shared rate
# limit. Without it the tutor answers from general knowledge and uses an
# in-memory cache and limit. The secret's SHA-256 must be stored in
# shikhbo.app_secret (see the migration in supabase/migrations).
SHIKHBO_STORE_URL=
SHIKHBO_STORE_SECRET=

# Optional site settings
# NEXT_PUBLIC_APP_URL=https://your-domain.example
# GOOGLE_SITE_VERIFICATION=
